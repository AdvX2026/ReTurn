# Server (Node ≥ 22.13 required — node:sqlite without --experimental-sqlite)
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# Local timezone used for day bucketing (YYYY-MM-DD). Default: system TZ.
# TZ=Asia/Shanghai

# Health shortcut token (Shortcuts header: X-Return-Token). REQUIRED for /api/health.
# Empty or "change-me-health-token" → endpoint disabled (503). Use a real secret.
HEALTH_TOKEN=

# Optional shared secret for device/desktop APIs (same header style).
# Empty = open (hackathon LAN demo). Set when on untrusted Wi-Fi.
# API_TOKEN=change-me-api-token

# Optional CORS allowlist, comma-separated. Empty = reflect origin (dev).
# CORS_ORIGINS=http://localhost:1420,tauri://localhost

# OpenAI-compatible API (ferment + whisper). Keys stay on Pi only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Whisper-compatible transcription endpoint (same base or separate)
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_MS=60000

# Embedding channel for hybrid search (Phase 2). Explicit only — no LLM_* fallback.
# Empty any of base/key/model → keyword-only search. Base is API root, NOT .../embeddings.
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_TIMEOUT_MS=30000

# Sampling period used by session aggregation gap detection (minutes)
SAMPLE_INTERVAL_MIN=5

# -- Sampler ------------------------------------------------
# RETURN_SERVER_URL=http://127.0.0.1:8787
# SAMPLER_DEVICE_NAME=Mac Sampler
# SAMPLER_PORT=8791
# SAMPLER_DATA_DIR=
# Active (pre-Save) sample period minutes. Default 5.
# SAMPLE_INTERVAL_MIN=5
# Night (post-Save) sample period minutes. Default 30.
# SAMPLE_INTERVAL_NIGHT_MIN=30

# Comma-separated code roots for today local git commits (~ expanded).
# Empty (default) = feature off -- no git processes spawned.
# GIT_SCAN_DIRS=~/Coding,~/Projects
