# Server (Node ≥ 22.13 required — node:sqlite without --experimental-sqlite)
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# Local timezone used for day bucketing (YYYY-MM-DD). Default: system TZ.
# TZ=Asia/Shanghai

# Health shortcut token (Shortcuts header: X-Return-Token). REQUIRED for /api/health.
# Empty or "change-me-health-token" → endpoint disabled (503). Use a real secret.
HEALTH_TOKEN=

# Optional shared secret for device/desktop APIs (same header style).
# Empty = open (hackathon LAN demo). Set when on untrusted Wi-Fi.
# API_TOKEN=change-me-api-token

# Optional CORS allowlist, comma-separated. Empty = reflect origin (dev).
# CORS_ORIGINS=http://localhost:1420,tauri://localhost

# OpenAI-compatible API (ferment, ask, chat, resume, and vision).
# Empty key → AI endpoints return an explicit 503 (server still runs).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Whisper-compatible transcription endpoint. Falls back to LLM_BASE_URL/LLM_API_KEY.
# Neither set → /api/voice returns 503 (audio still saved).
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_MS=60000

# Embedding channel for hybrid search. Explicit only — no LLM_* fallback.
# Empty any of base/key/model → keyword-only search. Base is API root, NOT .../embeddings.
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_TIMEOUT_MS=30000

# Sampling period used by session aggregation gap detection (minutes)
SAMPLE_INTERVAL_MIN=5

# -- Sampler ------------------------------------------------
# RETURN_SERVER_URL=http://127.0.0.1:8787
# SAMPLER_DEVICE_NAME=Mac Sampler
# SAMPLER_PORT=8791
# SAMPLER_DATA_DIR=
# One IANA timezone shared by every sampler source.
# SAMPLER_TIMEZONE=Asia/Singapore
# Optional fixed clock for explicit replay/testing only; leave unset in production.
# SAMPLER_NOW=2026-07-24T12:00:00+08:00
# Active (pre-Save) sample period minutes. Default 5.
# SAMPLE_INTERVAL_MIN=5
# Night (post-Save) sample period minutes. Default 30.
# SAMPLE_INTERVAL_NIGHT_MIN=30

# Comma-separated code roots for today local git commits (~ expanded).
# Empty (default) = feature off -- no git processes spawned.
# GIT_SCAN_DIRS=~/Coding,~/Projects

# Gmail IMAP collector (received INBOX + Sent). Uses an app password, not your
# normal password: enable 2FA, then create one at https://myaccount.google.com/apppasswords
# Both empty = feature off (no IMAP connection). Setting only one of
# user/password is invalid partial config and fails startup.
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_PASSWORD=your-app-password
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993

# Apple Reminders sample source (darwin only; non-mac always empty).
# Default on when unset. Set 0/false to disable.
# REMINDERS_ENABLED=1

# VS Code / Cursor recent projects (state.vscdb). Empty = auto-detect
# Code / Code - Insiders / Cursor globalStorage path for this OS.
# VSCODE_STATE_DB=
# Set to 0/false to disable even when a db is found.
# VSCODE_ENABLED=1

# Chrome / Chromium / Edge / Brave browse history (today's visits).
# Auto-detects Default + Profile 1..3 under known browser user-data dirs.
# CHROME_HISTORY_PATH=            # optional single-file override (skips auto-detect)
# CHROME_HISTORY_ENABLED=1        # default on; set 0/false to disable
# CHROME_HISTORY_LIMIT=100        # max visits per sample tick (across all DBs)

# Safari History.db (macOS; requires Full Disk Access for the sampler process).
# SAFARI_HISTORY_PATH=            # optional override; defaults to ~/Library/Safari/History.db
# SAFARI_HISTORY_ENABLED=1
# SAFARI_HISTORY_LIMIT=100
