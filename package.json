{
  "name": "return",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @return/server dev",
    "dev:sampler": "pnpm --filter @return/sampler dev",
    "build": "pnpm --filter @return/shared build && pnpm -r build",
    "typecheck": "pnpm --filter @return/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @return/shared build && pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "lint": "biome check packages",
    "lint:fix": "biome check --write packages",
    "start:server": "pnpm --filter @return/server start",
    "openapi": "pnpm --filter @return/server openapi"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
