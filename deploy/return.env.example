# Installed as /etc/return/return.env. Never commit real secrets.
HOST=0.0.0.0
PORT=8787
DATA_DIR=/var/lib/return
TZ=Asia/Shanghai

# Required on the demo hotspot: Node's IPv4/IPv6 family auto-selection can
# time out before the reachable IPv4 route is established.
NODE_OPTIONS="--no-network-family-autoselection --dns-result-order=ipv4first"

# Required for POST /api/health. Empty keeps the endpoint disabled.
HEALTH_TOKEN=

# Temporary hackathon mode: leave empty only on the controlled private hotspot
# until Issue #4 adds token propagation to sampler/client. Never expose TCP 8787
# to WAN or configure port forwarding while this is empty.
API_TOKEN=

# Native SwiftUI clients do not use browser CORS. Add origins only if needed.
CORS_ORIGINS=

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Empty base/key values fall back to the LLM values above.
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_MS=60000

SAMPLE_INTERVAL_MIN=5
